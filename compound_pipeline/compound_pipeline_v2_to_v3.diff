+def _file_identity(p) -> dict:
+    p = Path(p)
+    if not p.exists():
+        return {"path": str(p), "exists": False}
+    st = p.stat()
+    return {"path": str(p), "exists": True, "size_bytes": int(st.st_size),
+            "mtime_utc": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat()}
+
